{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kite RPC Response",
  "version": "kite.rpc.response/v1",
  "type": "object",
  "properties": {
    "error": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {}
  },
  "required": [
    "id",
    "method",
    "ok"
  ]
}
